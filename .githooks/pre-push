#!/usr/bin/env bash
# Runs the release job's web UI checks before a push to main, so a formatting
# slip fails here in seconds instead of failing the release on GitHub.
# Enable once per clone: git config core.hooksPath .githooks
set -e
while read -r _ _ remote_ref _; do
  [ "$remote_ref" = refs/heads/main ] || continue
  cd "$(git rev-parse --show-toplevel)/web-ui"
  npx biome ci . || { echo "pre-push: Biome failed. Run 'npx biome check --write .' in web-ui/." >&2; exit 1; }
  npx tsc --noEmit
  npm test --silent > /dev/null || { echo "pre-push: tests failed. Run 'npm test' in web-ui/." >&2; exit 1; }
  exit 0
done
